###############################################################################
# Nonalix IA — gabarit d'environnement de PRODUCTION.
#
# Sur le VPS :  cp .env.production.example .env  puis renseigner les secrets.
# Ce fichier est le seul endroit où vivent les clés : il n'entre ni dans le
# dépôt (.gitignore) ni dans l'image Docker (.dockerignore).
#
# Générer les secrets sur le serveur, jamais sur un poste de travail :
#   docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
#   openssl rand -hex 24   # pour DB_PASSWORD et REVERB_APP_SECRET
###############################################################################

# --- Application -------------------------------------------------------------
APP_NAME="Nonalix IA"
APP_ENV=production
# SAUVEGARDER CETTE CLÉ HORS DE LA BASE. Elle chiffre les jetons WhatsApp et
# les clés IA des clients : la perdre les rend définitivement illisibles.
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_URL=https://app.nonalixia.com

# --- Domaines des quatre espaces ---------------------------------------------
NONALIX_DOMAIN_MARKETING=nonalixia.com
NONALIX_DOMAIN_APP=app.nonalixia.com
NONALIX_DOMAIN_ADMIN=admin.nonalixia.com
NONALIX_DOMAIN_API=api.nonalixia.com

# Sert aussi d'adresse de contact Let's Encrypt (alertes d'expiration).
NONALIX_SUPPORT_EMAIL=support@nonalixia.com

# --- Base de données ---------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nonalix
DB_USERNAME=nonalix
DB_PASSWORD=

# --- Redis -------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_MAXMEMORY=1gb

# --- Cache, sessions, files d'attente ----------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=nonalix_cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
# Le point initial est requis : il partage la session entre app. et admin.
SESSION_DOMAIN=.nonalixia.com
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# --- Horizon -----------------------------------------------------------------
HORIZON_PREFIX=nonalix_horizon
HORIZON_MAX_PROCESSES=12

# --- Reverb (WebSocket) ------------------------------------------------------
# REVERB_APP_KEY est lue au BUILD de l'image (bundle front). La changer impose
# de reconstruire : `docker compose -f docker-compose.prod.yml build app web`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Fournisseurs IA ---------------------------------------------------------
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_CHAT_MODEL=gpt-4.1-mini
AI_FALLBACK_PROVIDER=anthropic

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

GEMINI_API_KEY=

# --- Embeddings --------------------------------------------------------------
# Changer ces valeurs impose un réindexage complet : les espaces vectoriels de
# deux modèles ne sont pas comparables.
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# --- WhatsApp Cloud API ------------------------------------------------------
WHATSAPP_API_VERSION=v23.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_TIMEOUT=15
WHATSAPP_MAX_RETRIES=3
WHATSAPP_SERVICE_WINDOW_HOURS=24
# Toute autre valeur que false ouvre les webhooks à des messages non signés.
WHATSAPP_ALLOW_UNSIGNED=false

# --- Quotas et coûts ---------------------------------------------------------
QUOTA_ENFORCEMENT=true
QUOTA_ALERT_THRESHOLD=80

# --- Messagerie sortante -----------------------------------------------------
# Mailpit n'existe pas en production : un vrai relais SMTP est indispensable
# (vérification d'e-mail, réinitialisation de mot de passe, alertes).
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
# 465 = TLS implicite (SMTPS). Avec le port 587, utiliser `smtp` (STARTTLS).
MAIL_SCHEME=smtps
MAIL_USERNAME=contact@nonalixia.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@nonalixia.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Journalisation ----------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
# `debug` en production ferait fuir des charges utiles de webhook et des
# extraits de prompt dans les journaux.
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- Sécurité ----------------------------------------------------------------
BCRYPT_ROUNDS=12
TWO_FACTOR_REQUIRED_ROLES="super-admin,owner,admin"
# Sans ces domaines, Sanctum ne reconnaît pas les requêtes de l'espace client
# comme authentifiées par session : toutes les actions repartent en 401.
SANCTUM_STATEFUL_DOMAINS=app.nonalixia.com,admin.nonalixia.com

# --- Docker ------------------------------------------------------------------
DOCKER_TARGET=app
IMAGE_TAG=latest
# Port de la boucle locale sur lequel le Nginx de l'hôte relaie la stack.
# Le VPS sert déjà nonalix-ci.com sur 80/443 : la stack ne les prend pas.
APP_PORT=8081