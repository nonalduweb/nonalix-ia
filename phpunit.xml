<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>

    <!--
      IMPORTANT : chaque réglage est déclaré DEUX fois, en <env> et en <server>.

      Le conteneur applicatif reçoit le contenu de .env comme véritables
      variables d'environnement (env_file dans docker-compose). PHP peuple alors
      $_SERVER avec ces valeurs, et le repository Env de Laravel lit $_SERVER
      AVANT $_ENV. Or PHPUnit, même avec force="true", n'écrit que dans $_ENV et
      putenv() — jamais dans $_SERVER.

      Sans les <server>, la configuration ci-dessous est silencieusement ignorée
      et la suite s'exécute sur la base de DÉVELOPPEMENT, qu'elle efface à
      chaque lancement.
    -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>

        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <server name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>

        <env name="APP_DEBUG" value="true" force="true"/>
        <server name="APP_DEBUG" value="true" force="true"/>

        <!-- Doit correspondre à NONALIX_DOMAIN_APP : le routage est contraint
             par domaine, et une requête émise vers un autre hôte tomberait sur
             les routes du site commercial (404 trompeur). -->
        <env name="APP_URL" value="http://localhost" force="true"/>
        <server name="APP_URL" value="http://localhost" force="true"/>

        <!-- Base dédiée : les tests ne doivent jamais atteindre les données
             de développement. Les extensions y sont créées par la migration. -->
        <env name="DB_CONNECTION" value="pgsql_testing" force="true"/>
        <server name="DB_CONNECTION" value="pgsql_testing" force="true"/>

        <!-- Sync : les jobs s'exécutent en ligne, sauf Queue::fake() explicite. -->
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>

        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>

        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>

        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>

        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>

        <!-- Coût CPU divisé par ~30 sur la suite complète. -->
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>

        <!-- Domaines de test : les requêtes doivent viser les bons hôtes. -->
        <env name="NONALIX_DOMAIN_MARKETING" value="nonalixia.test" force="true"/>
        <server name="NONALIX_DOMAIN_MARKETING" value="nonalixia.test" force="true"/>

        <env name="NONALIX_DOMAIN_APP" value="localhost" force="true"/>
        <server name="NONALIX_DOMAIN_APP" value="localhost" force="true"/>

        <env name="NONALIX_DOMAIN_ADMIN" value="admin.nonalixia.test" force="true"/>
        <server name="NONALIX_DOMAIN_ADMIN" value="admin.nonalixia.test" force="true"/>

        <env name="NONALIX_DOMAIN_API" value="api.nonalixia.test" force="true"/>
        <server name="NONALIX_DOMAIN_API" value="api.nonalixia.test" force="true"/>

        <!-- Aucune clé réelle : tout appel sortant doit être simulé. -->
        <env name="OPENAI_API_KEY" value="test-openai-key" force="true"/>
        <server name="OPENAI_API_KEY" value="test-openai-key" force="true"/>

        <env name="ANTHROPIC_API_KEY" value="test-anthropic-key" force="true"/>
        <server name="ANTHROPIC_API_KEY" value="test-anthropic-key" force="true"/>

        <env name="GEMINI_API_KEY" value="test-gemini-key" force="true"/>
        <server name="GEMINI_API_KEY" value="test-gemini-key" force="true"/>

        <env name="AI_FALLBACK_PROVIDER" value="" force="true"/>
        <server name="AI_FALLBACK_PROVIDER" value="" force="true"/>

        <env name="QUOTA_ENFORCEMENT" value="true" force="true"/>
        <server name="QUOTA_ENFORCEMENT" value="true" force="true"/>

        <env name="WHATSAPP_ALLOW_UNSIGNED" value="false" force="true"/>
        <server name="WHATSAPP_ALLOW_UNSIGNED" value="false" force="true"/>
    </php>
</phpunit>
