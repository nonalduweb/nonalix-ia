      },
      {
        "parameters": { "respondWith": "firstIncomingItem", "options": {} },
        "id": "a1000000-0000-4000-8000-000000000006",
        "name": "Reponse e-mail (200)",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [380, 300]
      },

      {
        "parameters": {
          "jsCode": "// 501 et NON 200 : cote Laravel, un 2xx vaut succes et ferait inscrire\n// un faux rendez-vous ou un faux devis dans les metriques commerciales.\nconst action = $json.action ?? 'inconnue';\nreturn [{ json: { message: `Action ${action} non encore raccordee a un systeme metier.` } }];"
        },
        "id": "a1000000-0000-4000-8000-00000000000a",
        "name": "Message non raccorde",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [-100, 500]
      },
