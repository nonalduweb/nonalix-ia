###############################################################################
# Nonalix IA — variables d'environnement
#
# Copier en .env puis renseigner. AUCUNE valeur réelle ne doit être commitée.
#   cp .env.example .env && docker compose run --rm app php artisan key:generate
###############################################################################

# --- Application -------------------------------------------------------------
APP_NAME="Nonalix IA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_URL=http://nonalixia.test

# --- Domaines des quatre espaces ---------------------------------------------
# Production : nonalixia.com / app.nonalixia.com / admin.nonalixia.com / api.nonalixia.com
NONALIX_DOMAIN_MARKETING=nonalixia.test
NONALIX_DOMAIN_APP=app.nonalixia.test
NONALIX_DOMAIN_ADMIN=admin.nonalixia.test
NONALIX_DOMAIN_API=api.nonalixia.test

# Adresse de support affichée aux clients et utilisée pour les incidents.
NONALIX_SUPPORT_EMAIL=support@nonalixia.com

# --- Base de données ---------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nonalix
DB_USERNAME=nonalix
DB_PASSWORD=
DB_PORT_EXTERNAL=5432

# Base utilisée par Pest (voir phpunit.xml).
DB_TEST_DATABASE=nonalix_testing

# --- Redis -------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# --- Cache, sessions, files d'attente ----------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=nonalix_cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
# Cookie partagé entre app./admin. — le point initial est requis.
SESSION_DOMAIN=.nonalixia.test
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# --- Horizon -----------------------------------------------------------------
HORIZON_PREFIX=nonalix_horizon
HORIZON_MAX_PROCESSES=12

# --- Reverb (WebSocket) ------------------------------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Vues côté navigateur :
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=app.nonalixia.test
VITE_REVERB_PORT=80
VITE_REVERB_SCHEME=http

# --- Fournisseurs IA ---------------------------------------------------------
# Clés de la plateforme, utilisées par défaut. Un tenant peut fournir les siennes
# (stockées chiffrées en base) — elles priment alors sur ces valeurs.
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_CHAT_MODEL=gpt-4.1-mini
AI_FALLBACK_PROVIDER=anthropic

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Embeddings --------------------------------------------------------------
# ATTENTION : changer ces valeurs impose un réindexage complet de tous les
# documents (les espaces vectoriels ne sont pas comparables entre modèles).
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# --- WhatsApp Cloud API ------------------------------------------------------
# Les identifiants par tenant (token, app secret) sont en base, chiffrés.
# Ces variables ne servent qu'aux réglages globaux du client HTTP.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_TIMEOUT=15
WHATSAPP_MAX_RETRIES=3
# Fenêtre de service Meta, en heures. Ne pas modifier sans raison.
WHATSAPP_SERVICE_WINDOW_HOURS=24

# --- Quotas et coûts ---------------------------------------------------------
QUOTA_ENFORCEMENT=true
QUOTA_ALERT_THRESHOLD=80

# --- Messagerie sortante -----------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@nonalixia.com"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_PORT=8025

# --- Journalisation ----------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# --- Sécurité ----------------------------------------------------------------
BCRYPT_ROUNDS=12
# 2FA obligatoire pour les rôles à privilèges (owner, admin, super-admin).
TWO_FACTOR_REQUIRED_ROLES="super-admin,owner,admin"
SANCTUM_STATEFUL_DOMAINS=app.nonalixia.test,admin.nonalixia.test

# --- Docker ------------------------------------------------------------------
DOCKER_TARGET=dev
HTTP_PORT=80
VITE_PORT=5173
XDEBUG_MODE=off
CONTAINER_ROLE=app
RUN_MIGRATIONS=true
